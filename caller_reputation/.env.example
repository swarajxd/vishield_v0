# Secret salt for HMAC-SHA256 hashing of phone numbers.
# NEVER commit the real salt to source control!
NUMBER_HASH_SALT=sentinel-evaluator-super-secret-salt-2026

# SQLite database or PostgreSQL connection URL
DATABASE_URL=sqlite:///./reputation.db

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Scraper identification for robots.txt / site policies
CONTACT_EMAIL=student-researcher@university.edu

# Optional third-party API key for IPQualityScore
IPQS_API_KEY=

# Live Stream Analysis — ElevenLabs Scribe speech-to-text
# Sign up at elevenlabs.io, copy your API key, and paste it below (no quotes, no spaces):
ELEVENLABS_API_KEY=
ELEVEN_LABS_MODEL_ID=scribe_v1
# elevenlabs | mock | whisper | azure
VISHIELD_STT_BACKEND=elevenlabs
# Set STT_ALLOW_MOCK=true only if you want to explicitly allow deterministic mock STT when no key is set
STT_ALLOW_MOCK=false
