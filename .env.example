# ==============================================================================
# Voice Phishing Evaluator - Risk Fusion Engine Configuration
# ==============================================================================

# Application Metadata
APP_NAME="Voice Phishing Evaluator - Risk Fusion Engine"
APP_VERSION=1.0.0
ENVIRONMENT=development

# Fusion Scoring Weights (Must sum to exactly 1.00)
WEIGHT_CONVERSATION=0.50
WEIGHT_VOICE_SPOOF=0.30
WEIGHT_CALLER_REPUTATION=0.20

# Risk Classification Thresholds
# SAFE: 0.00 to 0.39
# SUSPICIOUS: 0.40 to 0.69
# HIGH_RISK: 0.70 to 1.00
THRESHOLD_SAFE_MAX=0.39
THRESHOLD_SUSPICIOUS_MIN=0.40
THRESHOLD_SUSPICIOUS_MAX=0.69
THRESHOLD_HIGH_RISK_MIN=0.70

# Operational Policies
# Default is REJECT: incomplete requests without all three signals are rejected with HTTP 422
MISSING_SIGNAL_POLICY=REJECT
MAX_BATCH_SIZE=100
SCORE_PRECISION_DECIMALS=4
